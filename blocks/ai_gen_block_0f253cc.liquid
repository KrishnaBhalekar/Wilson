{% doc %}
  @prompt
    i want  the the filter bar horizontal for this collection page in one line into the left side of horizontal line all th filte options like the sort & filter , size all the remaning & the right side i will select the grid view like the 1 2 3 4, i want  the the filter bar horizontal for this collection page in one line into the left side of horizontal line all th filte options like the sort & filter , size all the remaning & the right side i will select the grid view like the 1 2 3 4
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-filter-bar-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    gap: 20px;
    min-height: 60px;
  }

  .ai-filter-left-section-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.filter_gap }}px;
    flex: 1;
    flex-wrap: nowrap;
    overflow-x: auto;
  }

  .ai-filter-right-section-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .ai-filter-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ai-filter-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: {{ block.settings.label_font_weight }};
    color: {{ block.settings.label_color }};
    margin-right: 4px;
  }

  .ai-filter-select-{{ ai_gen_id }} {
    padding: 8px 12px;
    border: 1px solid {{ block.settings.select_border_color }};
    border-radius: {{ block.settings.select_border_radius }}px;
    background-color: {{ block.settings.select_background_color }};
    color: {{ block.settings.select_text_color }};
    font-size: {{ block.settings.select_font_size }}px;
    min-width: 100px;
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");
    background-position: right 8px center;
    background-repeat: no-repeat;
    background-size: 16px;
    padding-right: 32px;
  }

  .ai-filter-select-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.select_focus_color }};
    outline-offset: 2px;
  }

  .ai-filter-button-{{ ai_gen_id }} {
    padding: 8px 16px;
    border: 1px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .ai-filter-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-grid-view-controls-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-grid-view-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.grid_label_font_size }}px;
    color: {{ block.settings.grid_label_color }};
    font-weight: {{ block.settings.label_font_weight }};
  }

  .ai-grid-view-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
    border: 1px solid {{ block.settings.grid_button_border_color }};
    border-radius: {{ block.settings.grid_button_border_radius }}px;
    overflow: hidden;
  }

  .ai-grid-view-button-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    border: none;
    background-color: {{ block.settings.grid_button_background_color }};
    color: {{ block.settings.grid_button_text_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    transition: all 0.3s ease;
    border-right: 1px solid {{ block.settings.grid_button_border_color }};
  }

  .ai-grid-view-button-{{ ai_gen_id }}:last-child {
    border-right: none;
  }

  .ai-grid-view-button-{{ ai_gen_id }}:hover,
  .ai-grid-view-button-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.grid_button_active_background_color }};
    color: {{ block.settings.grid_button_active_text_color }};
  }

  .ai-grid-view-button-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.select_focus_color }};
    outline-offset: 2px;
  }

  .ai-filter-icon-{{ ai_gen_id }} {
    width: 14px;
    height: 14px;
  }

  .ai-divider-{{ ai_gen_id }} {
    width: 1px;
    height: 24px;
    background-color: {{ block.settings.divider_color }};
    margin: 0 4px;
  }

  @media screen and (max-width: 1024px) {
    .ai-filter-left-section-{{ ai_gen_id }} {
      gap: {{ block.settings.filter_gap | divided_by: 1.5 }}px;
    }
    
    .ai-filter-select-{{ ai_gen_id }} {
      min-width: 80px;
      font-size: {{ block.settings.select_font_size | minus: 1 }}px;
    }
  }

  @media screen and (max-width: 768px) {
    .ai-collection-filter-bar-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 12px;
      align-items: stretch;
    }

    .ai-filter-left-section-{{ ai_gen_id }} {
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: 4px;
    }

    .ai-filter-right-section-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-grid-view-label-{{ ai_gen_id }} {
      display: none;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-filter-left-section-{{ ai_gen_id }} {
      gap: 8px;
    }
    
    .ai-filter-select-{{ ai_gen_id }} {
      min-width: 70px;
      padding: 6px 24px 6px 8px;
    }
    
    .ai-filter-button-{{ ai_gen_id }} {
      padding: 6px 12px;
    }
  }
{% endstyle %}

<collection-filter-bar-{{ ai_gen_id }}
  class="ai-collection-filter-bar-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-filter-left-section-{{ ai_gen_id }}">
    {% if block.settings.show_sort %}
      <div class="ai-filter-item-{{ ai_gen_id }}">
        <label for="sort-{{ ai_gen_id }}" class="ai-filter-label-{{ ai_gen_id }}">
          {{ block.settings.sort_label }}:
        </label>
        <select id="sort-{{ ai_gen_id }}" class="ai-filter-select-{{ ai_gen_id }}" data-filter-type="sort">
          <option value="manual">{{ block.settings.sort_option_featured }}</option>
          <option value="best-selling">{{ block.settings.sort_option_best_selling }}</option>
          <option value="title-ascending">{{ block.settings.sort_option_alphabetically_az }}</option>
          <option value="title-descending">{{ block.settings.sort_option_alphabetically_za }}</option>
          <option value="price-ascending">{{ block.settings.sort_option_price_low_high }}</option>
          <option value="price-descending">{{ block.settings.sort_option_price_high_low }}</option>
          <option value="created-descending">{{ block.settings.sort_option_date_new_old }}</option>
          <option value="created-ascending">{{ block.settings.sort_option_date_old_new }}</option>
        </select>
      </div>
    {% endif %}

    {% liquid
      assign show_first_divider = false
      if block.settings.show_dividers and block.settings.show_sort and block.settings.show_filter_button
        assign show_first_divider = true
      endif
    %}
    {% if show_first_divider %}
      <div class="ai-divider-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if block.settings.show_filter_button %}
      <button class="ai-filter-button-{{ ai_gen_id }}" data-action="toggle-filters">
        <svg class="ai-filter-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
        </svg>
        {{ block.settings.filter_button_text }}
      </button>
    {% endif %}

    {% liquid
      assign show_second_divider = false
      assign has_other_filters = false
      if block.settings.show_size_filter or block.settings.show_color_filter or block.settings.show_price_filter or block.settings.show_brand_filter
        assign has_other_filters = true
      endif
      if block.settings.show_dividers and block.settings.show_filter_button and has_other_filters
        assign show_second_divider = true
      endif
    %}
    {% if show_second_divider %}
      <div class="ai-divider-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if block.settings.show_size_filter %}
      <div class="ai-filter-item-{{ ai_gen_id }}">
        <label for="size-{{ ai_gen_id }}" class="ai-filter-label-{{ ai_gen_id }}">
          {{ block.settings.size_label }}:
        </label>
        <select id="size-{{ ai_gen_id }}" class="ai-filter-select-{{ ai_gen_id }}" data-filter-type="size">
          <option value="">{{ block.settings.size_all_option }}</option>
          <option value="xs">XS</option>
          <option value="s">S</option>
          <option value="m">M</option>
          <option value="l">L</option>
          <option value="xl">XL</option>
          <option value="xxl">XXL</option>
        </select>
      </div>
    {% endif %}

    {% if block.settings.show_color_filter %}
      <div class="ai-filter-item-{{ ai_gen_id }}">
        <label for="color-{{ ai_gen_id }}" class="ai-filter-label-{{ ai_gen_id }}">
          {{ block.settings.color_label }}:
        </label>
        <select id="color-{{ ai_gen_id }}" class="ai-filter-select-{{ ai_gen_id }}" data-filter-type="color">
          <option value="">{{ block.settings.color_all_option }}</option>
          <option value="black">Black</option>
          <option value="white">White</option>
          <option value="red">Red</option>
          <option value="blue">Blue</option>
          <option value="green">Green</option>
          <option value="yellow">Yellow</option>
          <option value="pink">Pink</option>
          <option value="purple">Purple</option>
          <option value="gray">Gray</option>
          <option value="brown">Brown</option>
        </select>
      </div>
    {% endif %}

    {% if block.settings.show_price_filter %}
      <div class="ai-filter-item-{{ ai_gen_id }}">
        <label for="price-{{ ai_gen_id }}" class="ai-filter-label-{{ ai_gen_id }}">
          {{ block.settings.price_label }}:
        </label>
        <select id="price-{{ ai_gen_id }}" class="ai-filter-select-{{ ai_gen_id }}" data-filter-type="price">
          <option value="">{{ block.settings.price_all_option }}</option>
          <option value="0-25">Under ₹25</option>
          <option value="25-50">₹25 - ₹50</option>
          <option value="50-100">₹50 - ₹100</option>
          <option value="100-200">₹100 - ₹200</option>
          <option value="200-500">₹200 - ₹500</option>
          <option value="500+">Over ₹500</option>
        </select>
      </div>
    {% endif %}

    {% if block.settings.show_brand_filter %}
      <div class="ai-filter-item-{{ ai_gen_id }}">
        <label for="brand-{{ ai_gen_id }}" class="ai-filter-label-{{ ai_gen_id }}">
          {{ block.settings.brand_label }}:
        </label>
        <select id="brand-{{ ai_gen_id }}" class="ai-filter-select-{{ ai_gen_id }}" data-filter-type="brand">
          <option value="">{{ block.settings.brand_all_option }}</option>
          <option value="nike">Nike</option>
          <option value="adidas">Adidas</option>
          <option value="puma">Puma</option>
          <option value="reebok">Reebok</option>
          <option value="under-armour">Under Armour</option>
        </select>
      </div>
    {% endif %}
  </div>

  <div class="ai-filter-right-section-{{ ai_gen_id }}">
    <div class="ai-grid-view-controls-{{ ai_gen_id }}">
      <span class="ai-grid-view-label-{{ ai_gen_id }}">{{ block.settings.grid_view_label }}:</span>
      <div class="ai-grid-view-buttons-{{ ai_gen_id }}">
        <button 
          class="ai-grid-view-button-{{ ai_gen_id }} {% if block.settings.default_grid_columns == 1 %}active{% endif %}" 
          data-grid-columns="1"
          aria-label="1 column view"
        >
          1
        </button>
        <button 
          class="ai-grid-view-button-{{ ai_gen_id }} {% if block.settings.default_grid_columns == 2 %}active{% endif %}" 
          data-grid-columns="2"
          aria-label="2 columns view"
        >
          2
        </button>
        <button 
          class="ai-grid-view-button-{{ ai_gen_id }} {% if block.settings.default_grid_columns == 3 %}active{% endif %}" 
          data-grid-columns="3"
          aria-label="3 columns view"
        >
          3
        </button>
        <button 
          class="ai-grid-view-button-{{ ai_gen_id }} {% if block.settings.default_grid_columns == 4 %}active{% endif %}" 
          data-grid-columns="4"
          aria-label="4 columns view"
        >
          4
        </button>
      </div>
    </div>
  </div>
</collection-filter-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionFilterBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupEventListeners();
        this.initializeGridView();
        this.initializeFiltersFromURL();
      }

      setupEventListeners() {
        const sortSelect = this.querySelector('[data-filter-type="sort"]');
        const sizeSelect = this.querySelector('[data-filter-type="size"]');
        const colorSelect = this.querySelector('[data-filter-type="color"]');
        const priceSelect = this.querySelector('[data-filter-type="price"]');
        const brandSelect = this.querySelector('[data-filter-type="brand"]');
        const filterButton = this.querySelector('[data-action="toggle-filters"]');
        const gridButtons = this.querySelectorAll('[data-grid-columns]');

        if (sortSelect) {
          sortSelect.addEventListener('change', (e) => {
            this.handleSortChange(e.target.value);
          });
        }

        if (sizeSelect) {
          sizeSelect.addEventListener('change', (e) => {
            this.handleFilterChange('size', e.target.value);
          });
        }

        if (colorSelect) {
          colorSelect.addEventListener('change', (e) => {
            this.handleFilterChange('color', e.target.value);
          });
        }

        if (priceSelect) {
          priceSelect.addEventListener('change', (e) => {
            this.handleFilterChange('price', e.target.value);
          });
        }

        if (brandSelect) {
          brandSelect.addEventListener('change', (e) => {
            this.handleFilterChange('brand', e.target.value);
          });
        }

        if (filterButton) {
          filterButton.addEventListener('click', () => {
            this.toggleFilters();
          });
        }

        gridButtons.forEach(button => {
          button.addEventListener('click', (e) => {
            this.handleGridViewChange(e.target.dataset.gridColumns);
          });
        });
      }

      initializeFiltersFromURL() {
        const urlParams = new URLSearchParams(window.location.search);
        
        const sortSelect = this.querySelector('[data-filter-type="sort"]');
        if (sortSelect && urlParams.get('sort_by')) {
          sortSelect.value = urlParams.get('sort_by');
        }

        const sizeSelect = this.querySelector('[data-filter-type="size"]');
        if (sizeSelect && urlParams.get('size')) {
          sizeSelect.value = urlParams.get('size');
        }

        const colorSelect = this.querySelector('[data-filter-type="color"]');
        if (colorSelect && urlParams.get('color')) {
          colorSelect.value = urlParams.get('color');
        }

        const priceSelect = this.querySelector('[data-filter-type="price"]');
        if (priceSelect && urlParams.get('price')) {
          priceSelect.value = urlParams.get('price');
        }

        const brandSelect = this.querySelector('[data-filter-type="brand"]');
        if (brandSelect && urlParams.get('brand')) {
          brandSelect.value = urlParams.get('brand');
        }
      }

      handleSortChange(sortValue) {
        const url = new URL(window.location);
        if (sortValue === 'manual') {
          url.searchParams.delete('sort_by');
        } else {
          url.searchParams.set('sort_by', sortValue);
        }
        window.location.href = url.toString();
      }

      handleFilterChange(filterType, filterValue) {
        const url = new URL(window.location);
        if (filterValue === '') {
          url.searchParams.delete(filterType);
        } else {
          url.searchParams.set(filterType, filterValue);
        }
        window.location.href = url.toString();
      }

      toggleFilters() {
        const filterSidebar = document.querySelector('.collection-filters, .facets-wrapper, .filter-drawer');
        if (filterSidebar) {
          filterSidebar.classList.toggle('active');
          filterSidebar.classList.toggle('open');
        }
        
        const event = new CustomEvent('filter-toggle', {
          detail: { action: 'toggle' }
        });
        document.dispatchEvent(event);
      }

      handleGridViewChange(columns) {
        const gridButtons = this.querySelectorAll('[data-grid-columns]');
        gridButtons.forEach(btn => btn.classList.remove('active'));
        
        const activeButton = this.querySelector(`[data-grid-columns="${columns}"]`);
        if (activeButton) {
          activeButton.classList.add('active');
        }

        localStorage.setItem('collection-grid-columns', columns);

        const event = new CustomEvent('grid-view-change', {
          detail: { columns: parseInt(columns) }
        });
        document.dispatchEvent(event);

        const productGrid = document.querySelector('.product-grid, .collection-products, .grid');
        if (productGrid) {
          productGrid.style.setProperty('--grid-columns', columns);
          productGrid.classList.remove('grid-1', 'grid-2', 'grid-3', 'grid-4');
          productGrid.classList.add(`grid-${columns}`);
          
          productGrid.style.gridTemplateColumns = `repeat(${columns}, 1fr)`;
        }
      }

      initializeGridView() {
        const savedColumns = localStorage.getItem('collection-grid-columns');
        if (savedColumns) {
          this.handleGridViewChange(savedColumns);
        }
      }
    }

    customElements.define('collection-filter-bar-{{ ai_gen_id }}', CollectionFilterBar{{ ai_gen_id }});
  })();
</script>

