{% doc %}
  @prompt
    create the block for footer into single section 4 blocks for menu & one for Need help, into the need help i want 2 button live chat & Contact Us also above the text i want to add some text.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-block-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-footer-menu-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.menu_spacing }}px;
  }

  .ai-footer-menu-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.menu_title_size }}px;
    font-weight: {{ block.settings.menu_title_weight }};
    color: {{ block.settings.menu_title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    text-transform: {{ block.settings.menu_title_transform }};
  }

  .ai-footer-menu-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-footer-menu-item-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.menu_item_spacing }}px;
  }

  .ai-footer-menu-link-{{ ai_gen_id }} {
    color: {{ block.settings.menu_link_color }};
    text-decoration: none;
    font-size: {{ block.settings.menu_link_size }}px;
    transition: color 0.3s ease;
  }

  .ai-footer-menu-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.menu_link_hover_color }};
  }

  .ai-footer-help-section-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.menu_spacing }}px;
  }

  .ai-footer-help-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.menu_title_size }}px;
    font-weight: {{ block.settings.menu_title_weight }};
    color: {{ block.settings.menu_title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    text-transform: {{ block.settings.menu_title_transform }};
  }

  .ai-footer-help-text-{{ ai_gen_id }} {
    color: {{ block.settings.help_text_color }};
    font-size: {{ block.settings.help_text_size }}px;
    margin-bottom: {{ block.settings.help_text_spacing }}px;
    line-height: 1.5;
  }

  .ai-footer-help-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.button_spacing }}px;
  }

  .ai-footer-help-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: {{ block.settings.button_text_weight }};
    transition: all 0.3s ease;
    cursor: pointer;
    text-align: center;
  }

  .ai-footer-help-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-footer-help-buttons-{{ ai_gen_id }} {
      flex-direction: row;
      gap: {{ block.settings.button_spacing_desktop }}px;
    }
  }
{% endstyle %}

<div class="ai-footer-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% case block.type %}
    {% when 'menu_1' %}
      <div class="ai-footer-menu-{{ ai_gen_id }}">
        {% if block.settings.menu_title != blank %}
          <h3 class="ai-footer-menu-title-{{ ai_gen_id }}">{{ block.settings.menu_title }}</h3>
        {% endif %}
        {% if block.settings.menu_1 != blank %}
          <ul class="ai-footer-menu-list-{{ ai_gen_id }}">
            {% for link in block.settings.menu_1.links %}
              <li class="ai-footer-menu-item-{{ ai_gen_id }}">
                <a href="{{ link.url }}" class="ai-footer-menu-link-{{ ai_gen_id }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

    {% when 'menu_2' %}
      <div class="ai-footer-menu-{{ ai_gen_id }}">
        {% if block.settings.menu_title != blank %}
          <h3 class="ai-footer-menu-title-{{ ai_gen_id }}">{{ block.settings.menu_title }}</h3>
        {% endif %}
        {% if block.settings.menu_2 != blank %}
          <ul class="ai-footer-menu-list-{{ ai_gen_id }}">
            {% for link in block.settings.menu_2.links %}
              <li class="ai-footer-menu-item-{{ ai_gen_id }}">
                <a href="{{ link.url }}" class="ai-footer-menu-link-{{ ai_gen_id }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

    {% when 'menu_3' %}
      <div class="ai-footer-menu-{{ ai_gen_id }}">
        {% if block.settings.menu_title != blank %}
          <h3 class="ai-footer-menu-title-{{ ai_gen_id }}">{{ block.settings.menu_title }}</h3>
        {% endif %}
        {% if block.settings.menu_3 != blank %}
          <ul class="ai-footer-menu-list-{{ ai_gen_id }}">
            {% for link in block.settings.menu_3.links %}
              <li class="ai-footer-menu-item-{{ ai_gen_id }}">
                <a href="{{ link.url }}" class="ai-footer-menu-link-{{ ai_gen_id }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

    {% when 'menu_4' %}
      <div class="ai-footer-menu-{{ ai_gen_id }}">
        {% if block.settings.menu_title != blank %}
          <h3 class="ai-footer-menu-title-{{ ai_gen_id }}">{{ block.settings.menu_title }}</h3>
        {% endif %}
        {% if block.settings.menu_4 != blank %}
          <ul class="ai-footer-menu-list-{{ ai_gen_id }}">
            {% for link in block.settings.menu_4.links %}
              <li class="ai-footer-menu-item-{{ ai_gen_id }}">
                <a href="{{ link.url }}" class="ai-footer-menu-link-{{ ai_gen_id }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

    {% when 'need_help' %}
      <div class="ai-footer-help-section-{{ ai_gen_id }}">
        {% if block.settings.help_title != blank %}
          <h3 class="ai-footer-help-title-{{ ai_gen_id }}">{{ block.settings.help_title }}</h3>
        {% endif %}
        {% if block.settings.help_description != blank %}
          <div class="ai-footer-help-text-{{ ai_gen_id }}">
            {{ block.settings.help_description }}
          </div>
        {% endif %}
        <div class="ai-footer-help-buttons-{{ ai_gen_id }}">
          {% if block.settings.live_chat_text != blank %}
            <a href="{{ block.settings.live_chat_link }}" class="ai-footer-help-button-{{ ai_gen_id }}">
              {{ block.settings.live_chat_text }}
            </a>
          {% endif %}
          {% if block.settings.contact_us_text != blank %}
            <a href="{{ block.settings.contact_us_link }}" class="ai-footer-help-button-{{ ai_gen_id }}">
              {{ block.settings.contact_us_text }}
            </a>
          {% endif %}
        </div>
      </div>
  {% endcase %}
</div>

{% schema %}
