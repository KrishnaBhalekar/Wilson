{% doc %}
  @prompt
    create the section into it i want the 6 images with the 200 x 200 size i will add images below every image small text full content into one line also align to center intothe mobile view show 3-3 grid.
    
    Also i want add the link to every image & text., i want image size into the height: 150px width : 150px
    
    it is optimize accordingly to the screen size fit into it if left right space are remaning it's okk
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-grid-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-image-grid-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-image-grid-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    justify-items: center;
  }

  .ai-image-grid-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 150px;
  }

  .ai-image-grid-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }

  .ai-image-grid-link-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
  }

  .ai-image-grid-image-wrapper-{{ ai_gen_id }} {
    width: 150px;
    height: 150px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    margin-bottom: {{ block.settings.text_spacing }}px;
    position: relative;
  }

  .ai-image-grid-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-image-grid-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-grid-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.5;
  }

  .ai-image-grid-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 10px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-grid-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: {{ block.settings.text_weight }};
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
    max-width: 150px;
  }

  .ai-image-grid-text-placeholder-{{ ai_gen_id }} {
    color: #999;
    font-style: italic;
  }

  @media screen and (max-width: 1024px) {
    .ai-image-grid-wrapper-{{ ai_gen_id }} {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .ai-image-grid-wrapper-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
      gap: {{ block.settings.mobile_grid_gap }}px;
    }

    .ai-image-grid-image-wrapper-{{ ai_gen_id }} {
      width: 120px;
      height: 120px;
    }

    .ai-image-grid-item-{{ ai_gen_id }} {
      max-width: 120px;
    }

    .ai-image-grid-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
      max-width: 120px;
    }

    .ai-image-grid-placeholder-{{ ai_gen_id }} svg {
      width: 50px;
      height: 50px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-image-grid-wrapper-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_grid_gap | minus: 5 }}px;
    }

    .ai-image-grid-image-wrapper-{{ ai_gen_id }} {
      width: 100px;
      height: 100px;
    }

    .ai-image-grid-item-{{ ai_gen_id }} {
      max-width: 100px;
    }

    .ai-image-grid-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size | minus: 1 }}px;
      max-width: 100px;
    }

    .ai-image-grid-placeholder-{{ ai_gen_id }} svg {
      width: 40px;
      height: 40px;
    }

    .ai-image-grid-empty-state-{{ ai_gen_id }} {
      font-size: 9px;
      bottom: 5px;
    }
  }

  @media screen and (max-width: 360px) {
    .ai-image-grid-image-wrapper-{{ ai_gen_id }} {
      width: 90px;
      height: 90px;
    }

    .ai-image-grid-item-{{ ai_gen_id }} {
      max-width: 90px;
    }

    .ai-image-grid-text-{{ ai_gen_id }} {
      max-width: 90px;
    }
  }
{% endstyle %}

<div class="ai-image-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-grid-container-{{ ai_gen_id }}">
    <div class="ai-image-grid-wrapper-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign text_key = 'text_' | append: i
          assign link_key = 'link_' | append: i
          
          assign image = block.settings[image_key]
          assign text = block.settings[text_key]
          assign link = block.settings[link_key]
        %}
        
        <div class="ai-image-grid-item-{{ ai_gen_id }}">
          {% if link != blank %}
            <a href="{{ link }}" class="ai-image-grid-link-{{ ai_gen_id }}">
          {% endif %}
          
          <div class="ai-image-grid-image-wrapper-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 300 }}"
                alt="{{ image.alt | escape }}"
                class="ai-image-grid-image-{{ ai_gen_id }}"
                loading="lazy"
                width="150"
                height="150"
              >
            {% else %}
              <div class="ai-image-grid-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
                <div class="ai-image-grid-empty-state-{{ ai_gen_id }}">
                  Add image {{ i }}
                </div>
              </div>
            {% endif %}
          </div>
          
          {% if text != blank %}
            <div class="ai-image-grid-text-{{ ai_gen_id }}">{{ text }}</div>
          {% else %}
            <div class="ai-image-grid-text-{{ ai_gen_id }} ai-image-grid-text-placeholder-{{ ai_gen_id }}">Add text {{ i }}</div>
          {% endif %}
          
          {% if link != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

