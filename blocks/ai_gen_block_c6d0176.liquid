{% doc %}
  @prompt
    create the section into it 3 images  & below it i have the option to add the text to every image i also want to add the link to every image & the text.
    
    on mobile it's scroling like user will see the 1 full image & 30% of another image on mobile only., i want also option for the left & right padding, also provide me ratio size of full image  
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-images-section-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_left }}px {{ block.settings.section_padding_bottom }}px {{ block.settings.section_padding_right }}px;
  }

  .ai-three-images-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.desktop_gap }}px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-image-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    {% if block.settings.image_aspect_ratio == 'auto' %}
      height: auto;
    {% else %}
      aspect-ratio: {{ block.settings.image_aspect_ratio }};
    {% endif %}
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-image-{{ ai_gen_id }} {
    width: 100%;
    {% if block.settings.image_aspect_ratio == 'auto' %}
      height: auto;
      display: block;
    {% else %}
      height: 100%;
      object-fit: cover;
    {% endif %}
    transition: transform 0.3s ease;
  }

  .ai-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    {% if block.settings.image_aspect_ratio == 'auto' %}
      height: 300px;
    {% else %}
      height: 100%;
    {% endif %}
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-image-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-image-link-{{ ai_gen_id }}:hover .ai-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-text-content-{{ ai_gen_id }} {
    padding: {{ block.settings.text_padding_top }}px 0 0;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-text-content-{{ ai_gen_id }} h3 {
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    line-height: 1.3;
  }

  .ai-text-content-{{ ai_gen_id }} p {
    margin: 0;
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
  }

  .ai-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    background-color: rgba(0, 0, 0, 0.7);
    color: white;
    font-size: 12px;
    border-radius: 4px;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-three-images-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.8 }}px {{ block.settings.mobile_padding_left }}px {{ block.settings.section_padding_bottom | times: 0.8 }}px {{ block.settings.mobile_padding_right }}px;
    }

    .ai-three-images-container-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: {{ block.settings.mobile_gap }}px;
      padding: 0 20px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .ai-three-images-container-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-image-item-{{ ai_gen_id }} {
      flex: 0 0 calc(100% - {{ block.settings.mobile_peek }}px);
      scroll-snap-align: start;
    }

    .ai-image-item-{{ ai_gen_id }}:last-child {
      margin-right: 20px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-text-content-{{ ai_gen_id }} h3 {
      font-size: {{ block.settings.title_font_size | times: 0.9 }}px;
    }

    .ai-text-content-{{ ai_gen_id }} p {
      font-size: {{ block.settings.description_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-three-images-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-three-images-container-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign title_key = 'title_' | append: i
        assign description_key = 'description_' | append: i
        assign link_key = 'link_' | append: i

        assign image = block.settings[image_key]
        assign title = block.settings[title_key]
        assign description = block.settings[description_key]
        assign link = block.settings[link_key]
      %}

      <div class="ai-image-item-{{ ai_gen_id }}">
        {% if link != blank %}
          <a href="{{ link }}" class="ai-image-link-{{ ai_gen_id }}">
        {% endif %}

        <div class="ai-image-wrapper-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 800 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="ai-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-empty-state-{{ ai_gen_id }}">
                Add image {{ i }}
              </div>
            </div>
          {% endif %}
        </div>

        {% if link != blank %}
          </a>
        {% endif %}

        {% if title != blank or description != blank %}
          <div class="ai-text-content-{{ ai_gen_id }}">
            {% if title != blank %}
              {% if link != blank %}
                <a href="{{ link }}" class="ai-image-link-{{ ai_gen_id }}">
                  <h3>{{ title }}</h3>
                </a>
              {% else %}
                <h3>{{ title }}</h3>
              {% endif %}
            {% endif %}

            {% if description != blank %}
              <p>{{ description }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

